{
  "name": "doomdesk-ai-worker",
  "version": "1.0.0",
  "description": "Cloudflare Worker ingestion, news verification, and alert API for DoomDesk-AI",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute doomdesk-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute doomdesk-db --remote --file=./schema.sql"
  },
  "dependencies": {},
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240923.0",
    "typescript": "^5.5.4",
    "wrangler": "^3.78.0"
  }
}
